#!/bin/bash
# Gardena Smart System - Deinstallation (laeuft als ROOT)
#
# Das Plugin legt weder einen Systemdienst noch eine sudo-Regel oder einen
# Benutzer an - es gibt also nichts am System rueckgaengig zu machen. Was es
# hinterlaesst, sind Dateien mit Zugangsdaten:
#
#   gardena.cfg          Application Key und Application Secret im KLARTEXT,
#                        dazu das Zugriffstoken des Miniserver-Endpunkts
#   gardena_token.json   ein gueltiges OAuth2-Token der Husqvarna-Wolke
#   devices_cache.json   Klarnamen der Geraete, Service-Kennungen, Ladestaende
#
# LoxBerry raeumt config/ und data/ beim Entfernen normalerweise selbst auf.
# Verlassen wird sich darauf hier NICHT: der Aufwand ist ein rm, und der
# Schaden im Fehlerfall ist ein Anmeldegeheimnis, das auf der Karte
# liegenbleibt - fuer ein Konto, mit dem sich Maeher und Bewaesserung
# schalten lassen.

ARGV3=$3   # Installationsordner des Plugins
ARGV5=$5   # Wurzelverzeichnis des LoxBerry

BASE="${ARGV5:-$LBHOMEDIR}"
# Dritter Rueckfall: der eigene Ablageort. Bewusst kein fest verdrahteter
# Systempfad - LoxBerry laesst sich anderswohin installieren, und der
# Plugin-Pruefer sucht die Zeichenkette, ohne den Zusammenhang zu sehen.
# Installiert liegt dieses Skript unter <home>/data/system/uninstall/<ordner>
# (plugininstall.pl) - also DREI Ebenen hinauf, nicht vier. Bis 1.2.7 stand
# hier ein falscher Ablageort und /../../../.., das ueber die LoxBerry-Wurzel
# hinausfuehrte (Regeln/06). Gueltig nur, wenn dort wirklich ein LoxBerry liegt.
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(cd "$(dirname "$(readlink -f "$0")")/../../.." 2>/dev/null && pwd)
    if [ ! -f "$BASE/config/system/general.json" ]; then
        echo "<WARNING> LoxBerry-Wurzel nicht bestimmbar - es wurde nichts entfernt."
        exit 0
    fi
fi
PDIR="${ARGV3:-gardenasmartsystem}"

for verzeichnis in "$BASE/config/plugins/$PDIR" "$BASE/data/plugins/$PDIR" \
                   "$BASE/log/plugins/$PDIR"; do
    if [ -d "$verzeichnis" ]; then
        rm -rf "$verzeichnis"
        echo "<OK> $verzeichnis entfernt."
    fi
done

# ---------- Die Zweitschriften NEBEN dem Ordner ----------
# preupgrade.sh legt drei Kopien als GESCHWISTER des Konfigordners an
# (<ordner>.backup.gardena.cfg, .backup.gardena_token.json,
# .backup.devices_cache.json). Genau deshalb ueberstehen sie ein Update -
# und genau deshalb ueberstanden sie bis 1.2.5 auch die Deinstallation.
# Liegen geblieben waren damit das Application Secret, das Endpunkt-Token
# und ein gueltiges OAuth2-Token der Husqvarna-Wolke: Zugangsdaten zu einem
# Konto, mit dem sich Maeher und Bewaesserung schalten lassen. Die Zeile
# darunter behauptete trotzdem, sie seien geloescht.
for zweitschrift in "$BASE/config/plugins/$PDIR".backup.*; do
    if [ -f "$zweitschrift" ]; then
        rm -f "$zweitschrift"
        echo "<OK> Zweitschrift $zweitschrift entfernt."
    fi
done

# Nur sagen, was nachgesehen ist (Regeln/06): bis 1.2.7 stand der Satz unbedingt.
if [ -d "$BASE/config/plugins/$PDIR" ] || ls "$BASE/config/plugins/$PDIR".backup.* >/dev/null 2>&1; then
    echo "<WARNING> Es liegen noch Dateien mit Zugangsdaten unter $BASE/config/plugins - bitte von Hand entfernen."
else
    echo "<INFO> Zugangsdaten und Zugriffstoken des Plugins sind geloescht."
fi
echo "<INFO> Die Anwendung im Husqvarna Developer Portal bleibt bestehen -"
echo "<INFO> wer sie nicht mehr braucht, entfernt sie dort von Hand:"
echo "<INFO>   https://developer.husqvarnagroup.cloud/"

# ---------- Den Nachbarn der Sicherung wegraeumen ----------
# data/plugins/<ordner>.upgrade_sicherung liegt AUSSERHALB des Ordners, den
# LoxBerry beim Deinstallieren loescht - genau deshalb uebersteht er ein
# Update. Wer ihn hier nicht abraeumt, laesst Zugangsdaten liegen.
# Derselbe Rueckfall wie oben bei PDIR. Bis 1.2.5 standen hier zwei
# verschiedene: fehlte $3, raeumte die Schleife oben dank Vorgabe noch auf,
# dieser Block aber nicht - und die .upgrade_sicherung blieb samt
# Konfiguration liegen.
UN_FOLDER="$PDIR"
UN_BASE="${5:-$LBHOMEDIR}"
if [ -n "$UN_FOLDER" ] && [ -n "$UN_BASE" ] && [ -d "$UN_BASE/data/plugins" ]; then
    rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung" 2>/dev/null
fi
exit 0
