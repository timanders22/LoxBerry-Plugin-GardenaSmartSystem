#!/bin/sh
#
# GARDENA smart system - Waechter der Befehlsbruecke, minuetlich.
#
# Gruppe 5 / MQTT (1.2.21, Entwurf ga E10; Bauvorschrift Gruppe 1, Nachtrag 19.10.2026; Bauart Fensterbilanz
# 0.12.19): die Linie hat nur den Fuenf-Minuten-Takt (cron.05min -> gardenaMain.php), und gardenaMain.php endet in
# mehreren Faellen frueh ("Plugin aktiv: Nein", ohne Zugangsdaten, waehrend eines laufenden Abrufs). Der Waechter der
# gemeinsamen Stammfassung startet die Bruecke nur mit dem Haken "Befehle ueber MQTT annehmen" (ab Werk aus), haelt
# sie sonst an und sendet <praefix>/status/befehle (nie retained). Aufruf ueber bash (das Skript ist bash, nicht sh);
# stdout weg, die Fehlerausgabe nach cron.err wie in cron.05min.
#
# Die Platzhalter fuer bin- und Log-Ordner setzt der Installer ein; sie stehen deshalb NUR in den Befehlszeilen und
# nicht in diesem Kommentar.
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
touch "$ERR" 2>/dev/null
# 1.2.23 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 1.2.22 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
bash "REPLACELBPBINDIR/befehlsbruecke.sh" waechter >/dev/null 2>>"$ERR"
